package pages

import (
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Home(sightings []sighting.Sighting) {
	@layout.Base(layout.BaseProps{
		Title: "Wildlife Watch",
		Count: len(sightings),
	}) {
		{{ hero := components.NewHeroProps(sightings) }}
		{{ rooms := components.NewRooms(sightings) }}
		@components.Hero(hero)
		@components.Ticker(hero.Summary)
		@components.FloorPlan(rooms)
		@components.Rooms(rooms)
	}
}

package pages

import (
	"strconv"
	"workshop/web/views/layout"
)

templ Error(message string, code int) {
	@layout.Base(layout.BaseProps{
		Title: "Error " + strconv.Itoa(code),
		Count: 0,
	}) {
		<section class="error-page">
			<h1 class="chrome">{ strconv.Itoa(code) }</h1>
			<p>{ message }</p>
			<a class="gel gel--pink" href="/">Back to the gallery</a>
		</section>
	}
}

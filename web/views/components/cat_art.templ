package components

templ CatArt() {
	<svg class="art" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="art-title">
		<title id="art-title">A cubist wild-cat mask in pink leopard print, wearing oversized white sunglasses and a rhinestone tiara, against a gold savanna sun</title>
		<defs>
			<radialGradient id="art-sun" cx="50%" cy="45%" r="55%">
				<stop offset="0" stop-color="#FFE08A"></stop>
				<stop offset=".55" stop-color="#E0A526"></stop>
				<stop offset="1" stop-color="#8C5A06"></stop>
			</radialGradient>
			<linearGradient id="art-chrome" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#FFFFFF"></stop>
				<stop offset=".4" stop-color="#CFCFCF"></stop>
				<stop offset=".5" stop-color="#7E7E7E"></stop>
				<stop offset=".56" stop-color="#F4F4F4"></stop>
				<stop offset="1" stop-color="#A9A9A9"></stop>
			</linearGradient>
			<linearGradient id="art-lens" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#FF4FA3"></stop>
				<stop offset=".6" stop-color="#8A0F4C"></stop>
				<stop offset="1" stop-color="#2A0518"></stop>
			</linearGradient>
			<pattern id="art-rosettes" width="60" height="60" patternUnits="userSpaceOnUse">
				<rect width="60" height="60" fill="#FF8CC6"></rect>
				<g fill="#E0559C" stroke="#0B0B0B" stroke-width="3" stroke-linecap="round">
					<ellipse cx="13" cy="14" rx="7" ry="6" stroke-dasharray="9 4 6 5" transform="rotate(-20 13 14)"></ellipse>
					<ellipse cx="42" cy="11" rx="6" ry="7" stroke-dasharray="7 5 8 4"></ellipse>
					<ellipse cx="29" cy="33" rx="7.5" ry="6" stroke-dasharray="10 4 5 5" transform="rotate(15 29 33)"></ellipse>
					<ellipse cx="8" cy="46" rx="6" ry="6.5" stroke-dasharray="7 4 8 5"></ellipse>
					<ellipse cx="50" cy="44" rx="7" ry="5.5" stroke-dasharray="8 5 6 4" transform="rotate(30 50 44)"></ellipse>
				</g>
				<g fill="#0B0B0B">
					<circle cx="26" cy="8" r="1.6"></circle>
					<circle cx="56" cy="25" r="1.8"></circle>
					<circle cx="15" cy="30" r="1.3"></circle>
					<circle cx="39" cy="54" r="1.6"></circle>
				</g>
			</pattern>
			<path id="art-star" d="M0-24C3-3 3-3 24 0C3 3 3 3 0 24C-3 3-3 3-24 0C-3-3-3-3 0-24Z"></path>
		</defs>
		<circle cx="200" cy="200" r="176" fill="url(#art-sun)"></circle>
		<g fill="none" stroke="#0B0B0B" stroke-opacity=".22" stroke-width="2">
			<circle cx="200" cy="200" r="150"></circle>
			<circle cx="200" cy="200" r="126"></circle>
			<circle cx="200" cy="200" r="104"></circle>
		</g>
		<g stroke="#0B0B0B" stroke-width="4" stroke-linejoin="round">
			<polygon points="92,170 120,38 186,118" fill="url(#art-chrome)"></polygon>
			<polygon points="308,170 280,38 214,118" fill="url(#art-chrome)"></polygon>
		</g>
		<polygon points="112,150 126,80 162,122" fill="#FF2E93"></polygon>
		<polygon points="288,150 274,80 238,122" fill="#FF2E93"></polygon>
		<path d="M200 92L304 142L292 268L200 340L108 268L96 142Z" fill="url(#art-rosettes)" stroke="#0B0B0B" stroke-width="5" stroke-linejoin="round"></path>
		<path d="M200 92L304 142L292 268L200 340Z" fill="#0B0B0B" fill-opacity=".22"></path>
		<path d="M108 268L96 142L150 232Z" fill="#E0A526"></path>
		<g fill="none" stroke="#0B0B0B" stroke-linecap="round">
			<path d="M182 232Q180 256 164 284" stroke-width="7"></path>
			<path d="M218 232Q220 256 236 284" stroke-width="7"></path>
			<path d="M200 268Q200 284 184 290M200 268Q200 284 216 290" stroke-width="4"></path>
		</g>
		<path d="M186 250L214 250L200 268Z" fill="#0B0B0B"></path>
		<g stroke="#EDEDED" stroke-width="2" stroke-linecap="round">
			<path d="M150 262L48 246M152 274L44 284M156 286L58 318"></path>
			<path d="M250 262L352 246M248 274L356 284M244 286L342 318"></path>
		</g>
		<g fill="none" stroke="#FFFFFF" stroke-linecap="round">
			<path d="M100 186L86 176M300 186L314 176" stroke-width="8"></path>
			<path d="M192 192Q200 182 208 192" stroke-width="7"></path>
		</g>
		<g fill="url(#art-lens)" stroke="#FFFFFF" stroke-width="9">
			<rect x="100" y="164" width="94" height="64" rx="28"></rect>
			<rect x="206" y="164" width="94" height="64" rx="28"></rect>
		</g>
		<g fill="#FFFFFF">
			<path d="M120 176h15l-15 38h-10z" fill-opacity=".55"></path>
			<path d="M141 176h6l-15 38h-6z" fill-opacity=".35"></path>
			<path d="M226 176h15l-15 38h-10z" fill-opacity=".55"></path>
			<path d="M247 176h6l-15 38h-6z" fill-opacity=".35"></path>
		</g>
		<path d="M150 126Q200 102 250 126L242 104L232 114L224 88L212 110L200 60L188 110L176 88L168 114L158 104Z" fill="url(#art-chrome)" stroke="#0B0B0B" stroke-width="3" stroke-linejoin="round"></path>
		<circle cx="200" cy="80" r="6" fill="#FF2E93" stroke="#FFFFFF" stroke-width="2"></circle>
		<g fill="#FFFFFF" stroke="#0B0B0B" stroke-width="1">
			<circle cx="176" cy="101" r="3.5"></circle>
			<circle cx="224" cy="101" r="3.5"></circle>
			<circle cx="160" cy="113" r="2.5"></circle>
			<circle cx="240" cy="113" r="2.5"></circle>
			<circle cx="170" cy="118" r="2.2"></circle>
			<circle cx="185" cy="115" r="2.2"></circle>
			<circle cx="200" cy="114" r="2.2"></circle>
			<circle cx="215" cy="115" r="2.2"></circle>
			<circle cx="230" cy="118" r="2.2"></circle>
		</g>
		<g transform="translate(58 70)"><use class="sparkle" href="#art-star" fill="#FF2E93"></use></g>
		<g transform="translate(346 104) scale(.7)"><use class="sparkle" href="#art-star" fill="#FFFFFF"></use></g>
		<g transform="translate(336 334) scale(.5)"><use class="sparkle" href="#art-star" fill="#FFB3D9"></use></g>
		<g transform="translate(64 336) scale(.4)"><use class="sparkle" href="#art-star" fill="#FFFFFF"></use></g>
	</svg>
}

# Development or production.
APP_ENV=development

# SQLite database URL, a file: path or :memory:.
DB_URI=file:workshop.db

# Port the web command listens on.
PORT=8080

# GBIF API to use, defaults to the live one. Uncomment to use the mock
# (make mock) when GBIF is down.
# GBIF_BASE_URL=http://localhost:8082/gbif/v1

# Open-Meteo API to use, defaults to the live one. Uncomment to use the mock
# (make mock) when Open-Meteo is down or rate limiting.
# OPEN_METEO_BASE_URL=http://localhost:8082/weather/v1

# Or skip editing this file and pass --local to the CLI instead, e.g.
# workshop --local sightings ingest -c KE -n 100
